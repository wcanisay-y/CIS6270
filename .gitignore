# Environments
.venv/

# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]

# Large regenerable binaries: checkpoints (ckpt/*.pt), the QM9 cache
# (project1/molecules/data/qm9.pt, 137 MB) and generated samples (results/*.pt).
# The metric JSONs and the figures produced FROM them are tracked, because the paper
# cites them. Force a specific file in with `git add -f` if one has to ship.
*.pt
*.sdf

# The raw QM9 download, and the novelty reference set that metrics.py builds from the
# training split on first use (97,626 SMILES, ~6 MB, rebuilt automatically in ~15 min).
# Note that data/qm9.py -- the loader that builds the cache -- is deliberately NOT
# ignored: a clean clone has to be able to rebuild the dataset.
project1/molecules/data/qm9_raw/
project1/molecules/data/train_smiles.json

# Helper scripts for defense/verification (not part of the method)
project1/molecules/scripts/
project1/proteins/scripts/

# Windows null device artifacts (created when bash misinterprets `> nul`)
nul

# Local smoke test outputs
project1/*/ckpt/
project1/*/results/
project1/*/out/

# ---------------------------------------------------------------------------
# Project 2 (masked diffusion on proteins)
# ---------------------------------------------------------------------------

# The virtualenv: 6.4 GB of torch 2.7.1 + transformers 4.57.6. Rebuild with
# run/mkvenv.sh, then run/fixdeps.sh.
project2/venv2/
project2/.piptmp/

# Downloaded corpora and structures, 285 MB, all re-fetchable:
#   swissprot_{train,dev}.txt  -> tools/cache_swissprot.py
#   pdb_cif/                   -> parallel/pdb_oracle.py (RCSB)
#   cath_raw/                  -> parallel/cath_oracle.py (download.cathdb.info, curl -L)
# Nothing in project2/data/ is hand-written, so none of it is source.
project2/data/

# project2/ckpt/{flat,dms6,rand6}.pt (152 MB each) are already covered by the
# *.pt rule above. Retrain with run/train_all.sh.
#
# project2/results/ IS tracked (15 MB of metric JSON, npz contact maps and the
# per-finding notes), as is project2/logs/ and project2/figures/, because the
# reports cite them line by line.
